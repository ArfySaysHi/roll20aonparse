{
  "manifest_version": 3,
  "name": "Roll20 Nethys NPC Importer",
  "version": "0.1.0",
  "description": "Import Pathfinder 1e monster stat blocks from Archives of Nethys into Roll20.",
  "browser_specific_settings": {
    "gecko": {
      "id": "nethys-roll20-importer@example.invalid",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://aonprd.com/*", "https://www.aonprd.com/*"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    {
      "matches": ["https://app.roll20.net/editor/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://app.roll20.net/editor/*"],
      "js": ["injected.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
